*1. Compliance Label (Target Variable)***\n","\n","* Define compliance benchmark (e.g., Paris Agreement 1.5°C pathway, or custom threshold).\n","\n","***2. Entity Type Encoding***\n","\n","One-hot encode parent_type (Investor-owned, State-owned, Nation-state).\n","\n","**3. Yearly emission change →** (current_year_emission - previous_year_emission) / previous_year_emission.\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"KAlJF9hCZS3e"},"outputs":[],"source":["import pandas as pd\n","\n","# Compliance threshold (example: 100 MtCO2e per year, you can replace with Paris/NDC target)\n","threshold = 100\n","\n","df_low['compliance'] = df_low['total_emissions_MtCO2e'].apply(\n","    lambda x: 1 if x <= threshold else 0\n",")\n","\n","# Encode entity type\n","df_low = pd.get_dummies(df_low, columns=['parent_type'])\n","\n","# Yearly emission change (grouped by entity)\n","df_low['emission_change'] = df_low.groupby('parent_entity')['total_emissions_MtCO2e'].pct_change()\n","\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":747},"executionInfo":{"elapsed":49,"status":"ok","timestamp":1757847417328,"user":{"displayName":"Garvita Aggarwal","userId":"10788119665591853136"},"user_tz":-330},"id":"HldrUGAmdEsn","outputId":"7b47fd6f-d16c-4315-be82-6da59c3bc1cb"},"outputs":[{"data":{"application/vnd.google.colaboratory.intrinsic+json":{"summary":"{\n  \"name\": \"df_low\",\n  \"rows\": 6069,\n  \"fields\": [\n    {\n      \"column\": \"year\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 29,\n        \"min\": 1854,\n        \"max\": 2022,\n        \"num_unique_values\": 169,\n        \"samples\": [\n          1888,\n          1992,\n          1869\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"parent_entity\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\